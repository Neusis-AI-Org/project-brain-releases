# Production reverse proxy for Project Brain.
#
# Default: Caddy auto-issues and renews a Let's Encrypt cert for {$APP_DOMAIN}
# on first start. HTTP→HTTPS redirect, HTTP/2, and HTTP/3 are on by default.
#
# Set APP_DOMAIN and ACME_EMAIL in .env (the prod overlay reads them).
#
# Custom certs (enterprise PKI / internal CA): set TLS_DIRECTIVE in .env to
#   tls /certs/fullchain.pem /certs/privkey.pem
# and bind-mount your cert files at ./certs. When TLS_DIRECTIVE is empty
# (the default), Caddy falls back to its built-in ACME flow. See docs/INSTALL.md.

{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    {$TLS_DIRECTIVE}

    encode zstd gzip

    # Reasonable client body cap (keep in sync with anything the worker or
    # web app accepts on file-upload routes).
    request_body {
        max_size 25MB
    }

    # Strict transport security — Caddy issues real certs, so HSTS is safe.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Don't leak the upstream — Caddy strips Server by default.
        -Server
    }

    # LLM router under a path prefix — no extra DNS record needed. Only the
    # gateway's /v1 API surface is reachable (agents' base URL is
    # https://APP_DOMAIN/router/v1); its dashboard/management API stays
    # private. The router.ROUTER_DOMAIN site below remains as an optional
    # subdomain alternative.
    #
    # Keep this matcher pinned to /router/v1/*. Project Brain serves its own
    # member-facing page at /router, which must fall through to web:3000 below.
    # Widening this to /router/* would proxy that page straight into the LLM
    # gateway, breaking it and exposing the gateway on a path users visit.
    # Model discovery is the one /v1 path Project Brain answers itself, so an
    # agent sees the curated selection from /admin/router instead of the
    # gateway's entire aggregated catalog (~1,200 entries with a reseller
    # connector attached, 11-20s cold). Caddy matches the more specific path
    # first, so this wins over the /router/v1/* handler below.
    #
    # Two consequences. The gateway's raw /v1/models is no longer reachable
    # publicly — PB's own calls are unaffected, they go to omniroute:20128
    # directly via ROUTER_INTERNAL_URL and never pass through Caddy. And if web
    # is down, model discovery fails while chat keeps working.
    handle /router/v1/models {
        rewrite * /api/router/v1/models
        reverse_proxy web:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # The key-authenticated config generator: one GET returns a developer's
    # agent config with the current model list already in it, so a new provider
    # never means re-pasting by hand.
    handle /router/config/* {
        # {uri} is the original request URI (a preceding strip_prefix does not
        # change it), so rewrite straight to /api + the path as sent. The
        # placeholder carries the query string too, which is what keeps
        # ?name=<provider name in config> working.
        rewrite * /api{uri}
        reverse_proxy web:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /router/v1/* {
        uri strip_prefix /router
        reverse_proxy omniroute:20128 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy web:3000 {
            # Pass real client IP through to Next.js. Auth.js and any rate
            # limits read these.
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# OmniRoute LLM gateway (dashboard + OpenAI/Anthropic-compatible /v1 API).
# Coding agents on developer machines point at https://<ROUTER_DOMAIN>/v1 with
# a key minted from PB's /admin/router tab. Set ROUTER_DOMAIN in .env (e.g.
# router.pbtest.neusis.ai) and add a DNS A record for it pointing at this
# host; Caddy then auto-issues a cert. When ROUTER_DOMAIN is unset the block
# falls back to router.localhost (internal cert, effectively unreachable),
# so deployments that don't run the omniroute service are unaffected.
{$ROUTER_DOMAIN:router.localhost} {
    {$TLS_DIRECTIVE}

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Agents only ever need the OpenAI/Anthropic-compatible /v1 surface.
    # Everything else (dashboard, management API) stays private: it removes
    # the pre-onboarding unauthenticated window from the public host, and
    # operators reach the console via an SSH tunnel when needed.
    # Curated model listing and the config generator are served by Project
    # Brain; see the matching handlers on the app-domain site above for why.
    handle /v1/models {
        rewrite * /api/router/v1/models
        reverse_proxy web:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /config/* {
        rewrite * /api/router{uri}
        reverse_proxy web:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /v1/* {
        reverse_proxy omniroute:20128 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        respond 404
    }
}

# ============================================================
# Project Brain — environment configuration
#
# Copy this file to .env and fill it in. Docker Compose loads it via
# `env_file: .env` for both web and worker.
#
# Sections:
#   1. Required        — must be set for the app to boot
#   2. Integrations    — optional providers (GitHub App, Atlassian, Sentry)
#   3. Production      — only used by docker-compose.prod.yml
# ============================================================

# ─── Docker Compose ─────────────────────────────────────────
# Default file stack so plain `docker compose <cmd>` includes the dev
# overlay (host port mappings for 5432/6379, source bind mounts, tsx watch).
# Prod deploys pass `-f` explicitly so they're unaffected. Comment out or
# unset to fall back to compose's default (docker-compose.yml only).
# COMPOSE_PATH_SEPARATOR pins the delimiter — without it Windows treats ':'
# as part of a filename and POSIX treats ';' as a shell separator.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml


# ─── 1. Required ────────────────────────────────────────────

# --- Core -------------------------------------------------------
NODE_ENV=production
APP_URL=http://localhost:3000

# --- Secrets (generate fresh values) ----------------------------
# Any secret below may instead be injected from a file via a `<NAME>_FILE`
# pointer (e.g. BRAIN_MASTER_KEY_FILE=/run/secrets/brain-master-key). The file
# wins over an inline value and keeps the secret out of `docker inspect` /
# `/proc/<pid>/environ`. Works with Docker/K8s secrets, Vault Agent file sinks,
# and an AWS Secrets Manager sidecar. File-backed names: BRAIN_MASTER_KEY,
# DATABASE_URL, AUTH_SECRET, INTERNAL_SERVICE_TOKEN, GRAPHIFY_SIDECAR_TOKEN,
# and AUTH_AZURE_AD_CLIENT_SECRET.
# Generate: openssl rand -base64 32
BRAIN_MASTER_KEY=
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# --- Key management (KMS) ---------------------------------------
# local (default) | aws. With aws, credential encryption uses KMS envelope
# encryption (DEK wrapped by KMS_KEY_REF) and the GitHub App private key is
# imported into a non-exportable KMS signing key — no plaintext keys persist.
# See docs/security.md.
KMS_PROVIDER=local
# Required when KMS_PROVIDER=aws (the CMK ARN for credential encryption):
KMS_KEY_REF=
# Populated automatically by the GitHub App import flow; override only for
# manual/advanced setups.
KMS_SIGNING_KEY_REF=

# --- Database & Redis -------------------------------------------
# DATABASE_URL hostnames: use `postgres`/`redis` for the docker-compose path,
# `localhost` for host-native dev. Password must match POSTGRES_PASSWORD.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://brain:changeme@postgres:5432/projectbrain
REDIS_URL=redis://redis:6379
# Per-process Postgres pool size. Compose injects 25 for web and 5 for worker
# automatically (PG_POOL_MAX_WEB / PG_POOL_MAX_WORKER); override here if you
# run a service outside compose. Default applied by packages/db/src/client.ts
# is 10. idle_timeout defaults to 60s (PG_IDLE_TIMEOUT).
# PG_POOL_MAX_WEB=25
# PG_POOL_MAX_WORKER=5

# --- Authentication ---------------------------------------------
AUTH_URL=http://localhost:3000

# First user with this email is auto-promoted to super_admin on sign-in.
# CLI fallback: `pnpm --filter @projectbrain/web admin:promote <email>`
INITIAL_SUPER_ADMIN_EMAIL=

# Comma-separated allow-list. Empty = accept any email the IdP admits.
AUTH_ALLOWED_EMAIL_DOMAINS=

# Comma-separated allow-list of EXACT addresses, for admitting individuals on
# consumer domains (gmail.com, outlook.com) without opening the whole domain.
# A user passes if they match this list OR AUTH_ALLOWED_EMAIL_DOMAINS above.
# Leaving BOTH empty accepts any email the IdP admits — which, with
# AUTH_AZURE_AD_TENANT_ID=common or with Google sign-in enabled below, is
# every Microsoft/Google account on the internet.
AUTH_ALLOWED_EMAILS=

# Microsoft Entra ID (Azure AD) OIDC — production SSO.
# Redirect URI to register on the IdP: ${APP_URL}/api/auth/callback/microsoft-entra-id
AUTH_AZURE_AD_TENANT_ID=
AUTH_AZURE_AD_CLIENT_ID=
AUTH_AZURE_AD_CLIENT_SECRET=

# Google OIDC — for users on gmail.com who have no account in your Entra
# tenant. Both empty = the Google button is not rendered at all.
# Redirect URI to register on Google: ${APP_URL}/api/auth/callback/google
# NOTE: Google has no tenant equivalent — enabling it authenticates every
# Google account, so an allow-list above is REQUIRED. With both allow-lists
# empty these credentials are ignored and the provider refuses to load.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Dev-only email-only credentials provider. Refuses to load when
# NODE_ENV=production. Never enable this on a real deploy.
DEV_AUTH_ENABLED=false

# Demo/staging escape hatch for the same email-only credentials provider.
# Unlike DEV_AUTH_ENABLED, this is honored even when NODE_ENV=production —
# it exists so prebuilt production images can run as demo deployments where
# Next.js has already inlined `process.env.NODE_ENV === 'production'` into
# the bundle at build time. NEVER set this on a deployment with real
# customer data: it bypasses SSO and signs anyone in by email alone.
DEMO_AUTH_ENABLED=false

# --- LLM provider -----------------------------------------------
# There is nothing to set here. Every Project Brain LLM call — the assistant
# and the graph builder — goes through the router sidecar, so provider API
# keys live in the router's own encrypted store, not in this file.
#
#   1. Bring up the router and initialize it at /admin/router.
#   2. Connect a provider there and pick the models it should offer. Adding
#      several keys for one provider is how you get rotation: the router
#      spreads traffic across them and cools down a key that hits a 429.
#   3. Choose the model for each workload at /admin/ai.
#
# See docs/router.md. Router connection settings are further down this file.

# --- Graphify sidecar hardening ---------------------------------
# Generate: openssl rand -hex 32
# Required by worker and graphify-sidecar. Keep it distinct from
# INTERNAL_SERVICE_TOKEN in production.
GRAPHIFY_SIDECAR_TOKEN=
# Wall-clock budget for one graph build, in seconds (default 1800).
# Mirrored source repos are one LLM call per file — raise for large repos.
#GRAPHIFY_TIMEOUT_S=7200
# Parallel LLM calls; match the provider RPM budget (free Gemini = 20/min → 3).
#GRAPHIFY_MAX_CONCURRENCY=3
# Files are packed into chunks of up to this many input tokens per LLM request
# (graphify --token-budget, upstream default 60000). Raise to pack more files
# per call; past ~80-100k dense chunks hit the 32k output cap and split-retry.
#GRAPHIFY_TOKEN_BUDGET=60000
# NOTE: this no longer constrains graph-builder LLM traffic. The sidecar
# reaches its model through the router (which is exempt from this proxy) and
# the router makes the upstream call, so the connector list in /admin/router
# is what bounds where model traffic goes. This allowlist still governs any
# other outbound request the sidecar makes, and the proxy refuses to start
# with an empty list.
GRAPHIFY_EGRESS_ALLOWED_HOSTS=generativelanguage.googleapis.com,api.openai.com,api.anthropic.com
GRAPHIFY_EGRESS_PROXY=http://graphify-egress-proxy:3128
# Debounce window for the auto graph rebuild the writer schedules after
# ingestion/human commits (milliseconds). Default: 300000 (5 minutes).
# GRAPHIFY_AUTO_REBUILD_DELAY_MS=300000

# --- OmniRoute LLM gateway sidecar -------------------------------
# The single LLM path: both external coding agents (neusis-code, Claude
# Code, …) and Project Brain's own assistant and graph builder call models
# through it. Not optional. See docs/router.md.
#
# Optional deployment override for the router management token. Normally
# Project Brain initializes the sidecar from /admin/router and stores an
# encrypted control token in Postgres. Set this only for backwards-compatible
# deployments or emergency recovery.
ROUTER_ADMIN_TOKEN=
# Host-run web development reaches the Docker router through its loopback
# port. Compose overrides this with its internal service hostname.
ROUTER_INTERNAL_URL=http://localhost:20128
# Public base URL shown to users in /admin/router (what agents connect to).
# Prod path route (no DNS record needed): https://<APP_DOMAIN>/router
# Or subdomain: https://${ROUTER_DOMAIN}. Dev default: http://localhost:20128
ROUTER_PUBLIC_URL=
# Optional subdomain alternative to the /router path route. Requires a DNS
# A record (e.g. router.pbtest.neusis.ai) pointing at the same host.
ROUTER_DOMAIN=

# --- Worker / scheduler -----------------------------------------
# Only one process across the deploy may have this true. Compose pins
# worker=true and forces web=false; do not flip per-service.
SCHEDULER_ENABLED=true


# ─── 2. Integrations (optional — leave blank to skip) ──────

# GitHub App: registered through /admin/integrations → Configure GitHub App.
# No env vars — credentials are stored encrypted on platform_integrations.

# Atlassian OAuth (Jira + Confluence): configured through
# /admin/integrations → Configure Atlassian OAuth. No env vars.

# --- Observability ----------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info


# ─── 3. Production deploy (docker-compose.prod.yml only) ───

# --- TLS / public domain (read by Caddy) ------------------------
# Example: brain.acme.com. Caddy issues a Let's Encrypt cert on first start.
APP_DOMAIN=
ACME_EMAIL=

# Customer-provided TLS certs (enterprise PKI / internal CA). Leave blank
# to use the default Let's Encrypt ACME flow. To serve your own cert:
#   1. Place fullchain.pem and privkey.pem in ./certs/ on the host.
#   2. Uncomment the line below (the path is inside the Caddy container).
#   3. Re-up Caddy: docker compose ... up -d caddy
# TLS_DIRECTIVE=tls /certs/fullchain.pem /certs/privkey.pem
TLS_DIRECTIVE=

# --- Backup retention -------------------------------------------
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
WORKSPACE_BACKUP_RETENTION_DAYS=14

# --- Image / release pinning ------------------------------------
# Source checkouts default to local/dev images. The public release mirror
# rewrites these defaults to ghcr.io/neusis-ai-org/latest for customer installs.
# For production, pin IMAGE_TAG to a version (vX.Y.Z) after install.
IMAGE_REGISTRY=ghcr.io/neusis-ai-org
IMAGE_TAG=latest
APP_VERSION=latest
GIT_SHA=unknown
BUILD_TIME=unknown

# When true, scripts/upgrade.sh runs `cosign verify` on each pulled image.
# Requires cosign on the host. Recommended for production.
COSIGN_VERIFY=false
